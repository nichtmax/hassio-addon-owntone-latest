#!/sbin/openrc-run
# shellcheck shell=sh
#
# OpenRC service: prepare persistent storage and render both daemon configs.

# OpenRC consumes this variable.
# shellcheck disable=SC2034
description="Render OwnTone config from add-on options"

CONFIG_PATH=/etc/owntone/owntone.conf
SHARE_DIR=/share/owntone

depend() {
    after modules
    before owntone
}

start() {
    ebegin "Preparing OwnTone directories"
    adduser -D -g owntone -h /dev/null -s /sbin/nologin owntone 2>/dev/null || true
    mkdir -p "$SHARE_DIR" "$SHARE_DIR/dbase_and_logs" "$SHARE_DIR/music"
    mkdir -p /etc/owntone
    chown owntone:owntone "$SHARE_DIR" "$SHARE_DIR/dbase_and_logs" "$SHARE_DIR/music"
    chmod 755 "$SHARE_DIR" "$SHARE_DIR/dbase_and_logs" "$SHARE_DIR/music"
    eend 0

    ebegin "Rendering OwnTone config"

    if ! /usr/local/bin/render-owntone-config; then
        eend 1
        return 1
    fi
    chown owntone:owntone "$CONFIG_PATH" /etc/shairport-sync.conf \
        "$SHARE_DIR/dbase_and_logs/owntone.conf" \
        "$SHARE_DIR/dbase_and_logs/shairport-sync.conf" 2>/dev/null || true

    eend 0
}

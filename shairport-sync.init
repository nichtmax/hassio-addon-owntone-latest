#!/sbin/openrc-run
# shellcheck shell=sh
#
# OpenRC service: shairport-sync AirPlay receiver.
# Receives AirPlay from phones, writes raw PCM to a named pipe that OwnTone
# watches (pipe_autostart) and redistributes to all enabled AirPlay outputs.
#
# OpenRC supervises the process and checks the actual RTSP endpoint.

# OpenRC consumes this variable.
# shellcheck disable=SC2034
description="shairport-sync AirPlay receiver (phone -> pipe -> OwnTone)"

PIPE=/share/owntone/music/AirPlay
METADATA_PIPE=/share/owntone/music/AirPlay.metadata
# Keep the receiver in the foreground so OpenRC owns and reaps it.
supervisor=supervise-daemon
command=/usr/bin/shairport-sync
command_args="-c /etc/shairport-sync.conf"
pidfile=/run/shairport-sync.supervisor.pid
respawn_delay=10
respawn_max=0
retry="TERM/5/KILL/5"
healthcheck_delay=60
healthcheck_timer=30
output_log=/proc/1/fd/1
error_log=/proc/1/fd/2

depend() {
    need owntone
}

start_pre() {
    # Ensure the audio pipe exists and is readable by the owntone user.
    if [ ! -p "$PIPE" ]; then
        rm -f "$PIPE"
        mkfifo -m 660 "$PIPE"
    fi
    chown owntone:owntone "$PIPE" 2>/dev/null || true
    chmod 660 "$PIPE"

    METADATA_ENABLED=$(jq -j --raw-output '.shairport.metadata_enabled // false' /data/options.json 2>/dev/null)

    if [ "$METADATA_ENABLED" = "true" ]; then
        if [ ! -p "$METADATA_PIPE" ]; then
            rm -f "$METADATA_PIPE"
            mkfifo -m 660 "$METADATA_PIPE"
        fi
        chown owntone:owntone "$METADATA_PIPE" 2>/dev/null || true
        chmod 660 "$METADATA_PIPE"
    else
        rm -f "$METADATA_PIPE"
    fi
    ebegin "Prepared shairport-sync audio pipe at $PIPE"
}

healthcheck() {
    /usr/local/bin/shairport-healthcheck
}

unhealthy() {
    ewarn "AirPlay handshake failed three times; restarting only shairport-sync"
}

{
  "general": {
    "admin_password": "p\"ass\\word",
    "loglevel": "debug",
    "trusted_networks": ["lan", "10.0.0.0/8"],
    "ipv6": true,
    "cache_daap_threshold": 1500,
    "speaker_autoselect": true,
    "high_resolution_clock": false,
    "start_buffer_ms": 500
  },
  "library": {
    "name": "Test %h",
    "password": "library secret",
    "follow_symlinks": false,
    "podcasts": ["/Podcasts"],
    "audiobooks": ["/Books"],
    "compilations": ["/Various"],
    "compilation_artist": "Various Artists",
    "hide_singles": true,
    "radio_playlists": true,
    "name_library": "Library",
    "name_music": "Music",
    "name_movies": "Movies",
    "name_tvshows": "TV Shows",
    "name_podcasts": "Podcasts",
    "name_audiobooks": "Audiobooks",
    "name_radio": "Radio",
    "name_chapter": "Chapter",
    "artwork_basenames": ["cover", "Folder"],
    "artwork_individual": true,
    "filetypes_ignore": [".pdf"],
    "filepath_ignore": ["/private/.*"],
    "filescan_disable": false,
    "only_first_genre": true,
    "m3u_overrides": true,
    "itunes_overrides": true,
    "itunes_smartpl": true,
    "no_decode": ["flac"],
    "force_decode": ["wma"],
    "prefer_format": "alac",
    "decode_audio_filters": ["loudnorm=I=-16:LRA=11:TP=-1.5"],
    "rating_updates": true,
    "read_rating": true,
    "write_rating": false,
    "max_rating": 100,
    "allow_modifying_stored_playlists": true,
    "default_playlist_directory": "/Playlists",
    "clear_queue_on_stop_disable": true
  },
  "audio": {
    "nickname": "Local output",
    "type": "pulseaudio",
    "server": "unix:/run/audio/native",
    "card": "default",
    "mixer": "PCM",
    "mixer_device": "default",
    "sync_disable": false,
    "adjust_period_seconds": 120
  },
  "alsa": [{"name": "USB DAC", "nickname": "Desk", "mixer": "PCM", "mixer_device": "hw:1"}],
  "fifo": {"nickname": "Recorder", "path": "/share/owntone/music/output.fifo"},
  "airplay_shared": {"uncompressed_alac": true},
  "airplay": [{"name": "Speaker \"One\"", "max_volume": 8, "exclude": false, "permanent": true, "reconnect": true, "password": "secret", "airplay2_disable": false, "nickname": "Room"}],
  "chromecast": [{"name": "Display", "max_volume": 7, "exclude": false, "nickname": "Kitchen"}],
  "spotify": {"bitrate": 3, "base_playlist_disable": true, "artist_override": true, "album_override": true, "initscan_disable": true},
  "rcp": [{"name": "SoundBridge", "exclude": false, "clear_on_close": true}],
  "mpd": {"enable_httpd_plugin": true},
  "sqlite": {"pragma_cache_size_library": 4000, "pragma_cache_size_cache": 3000, "pragma_journal_mode": "WAL", "pragma_synchronous": 1, "pragma_mmap_size_library": 1048576, "pragma_mmap_size_cache": 524288, "vacuum": false},
  "streaming": {"sample_rate": 48000, "bit_rate": 320},
  "shairport": {"name": "Multiroom \"Test\"", "password": "receiver secret", "metadata_enabled": true, "ignore_volume_control": false, "pipe_sample_rate": 96000, "pipe_sample_format": "S32_LE"}
}
